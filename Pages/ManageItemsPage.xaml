<Page x:Class="TabSplit.Pages.ManageItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit.Pages"
      mc:Ignorable="d" 
      xmlns:converters = "clr-namespace:TabSplit.Classes"
      xmlns:model="clr-namespace:TabSplit.Classes" 
      d:DesignHeight="450" d:DesignWidth="800" Background="LightBlue"
      Title="ManageItemsPage">

    <Grid Background="Transparent">
        <StackPanel Margin="10,10,10,10">

            <Menu Margin="0,0,0,0" VerticalAlignment="Top">
                <MenuItem Header="File">
                    <MenuItem Name="ClearButton" Header="Clear" Click="ClearButton_Click"></MenuItem>
                </MenuItem>
                <MenuItem Name="SortHeader" Header="Sort">
                    <MenuItem Name="AlphabetAscendingSortButton" Header="Alphabetical Ascending Order" Click="AlphabetAscendingSortButton_Click"></MenuItem>
                    <MenuItem Name="AlphabetDescendingSortButton" Header="Alphabetical Descending Order" Click="AlphabetDescendingSortButton_Click"></MenuItem>
                    <MenuItem Name="AscendingPriceButton" Header="Ascending Price" Click="AscendingPriceButton_Click"></MenuItem>
                    <MenuItem Name="DescendingPriceButton" Header="Descending Price" Click="DescendingPriceButton_Click"></MenuItem>
                </MenuItem>
            </Menu>

            <Button Name="AddItemButton" Content="Add Item" Background="LightGreen" Click="AddItemButton_Click"></Button>

            <Grid Margin="0, 5, 0, 0" Background="Gray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Label Content="Item Name" Grid.Column="0" Foreground="White" Margin="10, 0, 0, 0"></Label>
                <Label Content="Item Price" Grid.Column="1" Foreground="White"></Label>
            </Grid>

            <ListBox Name="ItemListBox" Background="White" Height="281" ItemsSource="{Binding Source={x:Static model:ItemManager.Instance}, Path=itemList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding name}" Foreground="Black" Grid.Column="0" VerticalAlignment="Center" Margin="5"></TextBox>
                            <TextBox Text="{Binding price}" PreviewTextInput="ItemPriceTextBox_PreviewTextInput" Foreground="Black" Grid.Column="1" VerticalAlignment="Center" Margin="5"></TextBox>
                            <Button Content="X" Foreground="Red" Click="DeleteButton_Click" Grid.Column="2" Margin="5"></Button>
                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Margin="0,5,0,0" Name="BackButton" Background="LightGreen" Content="Back" HorizontalAlignment="Left" Width="780" Height="34" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
