<Page x:Class="TabSplit.Pages.ManageItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit.Pages"
      mc:Ignorable="d" 
      xmlns:converters = "clr-namespace:TabSplit.Classes"
      xmlns:model="clr-namespace:TabSplit.Classes" 
      d:DesignHeight="450" d:DesignWidth="800" Background="LightBlue"
      Title="ManageItemsPage">

    <Grid>
        <StackPanel Margin="10,10,10,53">

            <Button Name="AddItemButton" Content="Add Item" Background="LightGreen" Click="AddItemButton_Click"></Button>

            <Grid Margin="0, 5, 0, 0" Background="Gray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Label Content="Item Name" Grid.Column="0" Foreground="White" Margin="10, 0, 0, 0"></Label>
                <Label Content="Item Price" Grid.Column="1" Foreground="White"></Label>
            </Grid>

            <ListBox Name="ItemListBox" Background="White" Height="337" ItemsSource="{Binding Source={x:Static model:ItemManager.Instance}, Path=itemList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding name}" Foreground="Black" Grid.Column="0" VerticalAlignment="Center" Margin="5"></TextBox>
                            <TextBox Text="{Binding price}" PreviewTextInput="ItemPriceTextBox_PreviewTextInput" Foreground="Black" Grid.Column="1" VerticalAlignment="Center" Margin="5"></TextBox>
                            <Button Content="X" Foreground="Red" Click="DeleteButton_Click" Grid.Column="2" Margin="5"></Button>
                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
        <Button Name="BackButton" Background="LightGreen" Content="Back" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="123" Height="48" Click="BackButton_Click"></Button>
    </Grid>
</Page>
