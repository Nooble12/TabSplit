<Page x:Class="TabSplit.Pages.SelectItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit.Pages"
      xmlns:model="clr-namespace:TabSplit.Classes" 
      mc:Ignorable="d" 
      Background="{DynamicResource BackgroundBrush}"
     d:DesignHeight="680" d:DesignWidth="1200"
      Title="SelectItemPage">

    <Grid>
        <StackPanel>
            
            <Grid Margin="0, 0, 0, 0" Background="{DynamicResource BackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Label Content="Item Name" FontSize="20" Grid.Column="0" Style="{DynamicResource LabelStyle}" Margin="10, 0, 0, 0"></Label>
                <Label Content="Item Price" FontSize="20" Grid.Column="1" Style="{DynamicResource LabelStyle}" Margin="10,0,0,0"></Label>
                <TextBox Name="SearchTextBox" Style="{DynamicResource RoundTextBox}" Height="40" Text="Search" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="2" Margin="0,0,-490,0"></TextBox>
            </Grid>

            <ListBox Name="ItemListBox" Background="{DynamicResource BackgroundBrush}"  Height="550" ItemsSource="{Binding ItemCatalog}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"></EventSetter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="{Binding name}" BorderBrush="{DynamicResource ForegroundBrush}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,0" FontSize="20"></Label>
                            <Label Content="{Binding price}" BorderBrush="{DynamicResource ForegroundBrush}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0" FontSize="20"></Label>
                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Name="CreateNewItem" Content="Create New Item" Background="LightGreen" Style="{DynamicResource RoundCorner}" Click="CreateNewItem_Click" Height="50"></Button>
        </StackPanel>

    </Grid>
</Page>
