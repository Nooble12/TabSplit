<Page x:Class="TabSplit.Pages.SelectItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit.Pages"
      xmlns:model="clr-namespace:TabSplit.Classes" 
      mc:Ignorable="d" 
      Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SelectItemPage">

    <Grid>
        <StackPanel Margin="10,10,10,12">
            <Grid Margin="0, 5, 0, 0" Background="Gray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Label Content="Item Name" Grid.Column="0" Foreground="White" Margin="10, 0, 0, 0"></Label>
                <Label Content="Item Price" Grid.Column="1" Foreground="White"></Label>
            </Grid>

            <ListBox Name="ItemListBox" Background="White" Height="305" ItemsSource="{Binding Source={x:Static model:ItemManager.Instance}, Path=itemList}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"></EventSetter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="{Binding name}" Foreground="Black" Grid.Column="0" VerticalAlignment="Center" Margin="5"></Label>
                            <Label Content="{Binding price}" Foreground="Black" Grid.Column="1" VerticalAlignment="Center" Margin="5"></Label>
                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Name="CreateNewItem" Content="Create New Item" Background="LightGreen" Click="CreateNewItem_Click" Height="50"></Button>
        </StackPanel>

    </Grid>
</Page>
