<Page x:Class="TabSplit.AddPersonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit"
      xmlns:converters = "clr-namespace:TabSplit.Classes"
      mc:Ignorable="d" 
     d:DesignHeight="680" d:DesignWidth="1200"
      Background="{DynamicResource BackgroundBrush}"
      Title="Add Person">

    <Page.Resources>
        <converters:FractionToFloatConverter x:Key = "FractionToFloatConverter"/>
    </Page.Resources>

    <Grid>
        <StackPanel>
            <TextBox Name="PersonNameTextBox" Text="{Binding name}" Style="{DynamicResource RoundTextBox}" FontSize="20" TextChanged="PersonNameTextBox_TextChanged" Height="50" VerticalContentAlignment="Center" Margin="0,5,0,0"></TextBox>
            <TextBox Name="ContactTextBox" Text="{Binding contactInfo}" Style="{DynamicResource RoundTextBox}" FontSize="20" TextChanged="ContactTextBox_TextChanged" Height="50" VerticalContentAlignment="Center" Margin="0,5,0,0"></TextBox>

            <Grid Margin="10, 5, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Label Content="Item Name" Grid.Column="0" FontSize="20" Style="{DynamicResource LabelStyle}"></Label>
                <Label Content="Item Price" Grid.Column="1" FontSize="20" Style="{DynamicResource LabelStyle}" ></Label>
                <Label Content="Item Quantity" Grid.Column="3" FontSize="20" Style="{DynamicResource LabelStyle}"></Label>
            </Grid>

            <ListBox Margin="0" Height="376" Name="ItemListBox" Background="{DynamicResource BackgroundBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ItemNameTextBox" TextChanged="ItemNameTextBox_TextChanged" Text="{Binding name}" Style="{DynamicResource RoundTextBox}" Margin="5" FontSize="20"></TextBox>
                            <TextBox Name="ItemPriceTextBox" PreviewTextInput="ItemPriceTextBox_PreviewTextInput" Text="{Binding price, Converter = {StaticResource FractionToFloatConverter}}" Style="{DynamicResource RoundTextBox}" Grid.Column="1" VerticalAlignment="Center" Margin="5" FontSize="20"></TextBox>
                            <TextBox Name="ItemQuantityTextBox" PreviewTextInput="ItemQuantityTextBox_PreviewTextInput" Text="{Binding quantity, Converter = {StaticResource FractionToFloatConverter}}" Style="{DynamicResource RoundTextBox}" Grid.Column="2" VerticalAlignment="Center" Margin="5" FontSize="20"></TextBox>
                            <Button Name="DeleteButton" Content="X" Click="DeleteButton_Click" Foreground="Red" FontSize="20" Style="{DynamicResource RoundCorner}" Background="Transparent" Grid.Column="3"></Button>
                        </Grid>

                       
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Margin="0,5,0,0" Name="AddItemButton" Content="Add Item" Background="LightGreen" Style="{DynamicResource RoundCorner}" Click="AddItemButton_Click" Height="50"></Button>
            <Button Margin="0,5,0,0" Name="ExitButton" Content="Finish" Background="PaleVioletRed" Style="{DynamicResource RoundCorner}" Click="ExitButton_Click" Height="50"></Button>
        </StackPanel>
    </Grid>
</Page>
