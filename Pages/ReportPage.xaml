<Page x:Class="TabSplit.Pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit.Pages"
      mc:Ignorable="d" 
      Background="Gray"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportPage">

    <Grid>
        <TextBox IsReadOnly="True" Name="ReportTextBox" HorizontalAlignment="Center" Foreground="Black" VerticalAlignment="Center" Height="300" Width="600"></TextBox>
        <Button Name="BackButton" Click="BackButton_Click" Height="20" VerticalAlignment="Bottom" Content="Back" Background="LightGreen"></Button>
    </Grid>
</Page>
