<Page x:Class="TabSplit.Pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit.Pages"
      mc:Ignorable="d" 
       d:DesignHeight="680" d:DesignWidth="1200" Background="{DynamicResource BackgroundBrush}"
      Title="ReportPage">

    <Grid>
        <StackPanel Margin="10">

            <TextBox IsReadOnly="True" Name="ReportTextBox" HorizontalAlignment="Center" Style="{DynamicResource RoundTextBox}" Padding="10" Height="545" Width="1163"/>
            <Button Name="ExportButton" Height="40" Content="Export" Style="{DynamicResource RoundCorner}" Background="LightSkyBlue"/>
            <Button Name="BackButton" Click="BackButton_Click" Height="40" Content="Back" Style="{DynamicResource RoundCorner}" Background="LightGreen"/>

        </StackPanel>
    </Grid>
</Page>
