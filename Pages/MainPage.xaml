<Page x:Class="TabSplit.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit"
      mc:Ignorable="d" 
      d:DesignHeight="680" d:DesignWidth="1200"
      Background="{DynamicResource BackgroundBrush}"
      Title="MainPage">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"></ColumnDefinition>
            <ColumnDefinition Width="780"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1">

            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"></ColumnDefinition>
                    <ColumnDefinition Width="180"></ColumnDefinition>
                    <ColumnDefinition Width="180"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label FontSize="20" Content="Name" Grid.Column="0" Style="{DynamicResource LabelStyle}"></Label>
                <Label FontSize="20" Content="Base Price" Grid.Column="1" Style="{DynamicResource LabelStyle}"></Label>
                <Label FontSize="20" Content="Total Price" Grid.Column="2" Style="{DynamicResource LabelStyle}"></Label>
            </Grid>

            <ListBox Margin="0, 5, 0, 0" Height="580" Name="ItemListBox" Background="{DynamicResource BackgroundBrush}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"></EventSetter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="{Binding name}" BorderBrush="{DynamicResource ForegroundBrush}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Grid.Column="0" VerticalAlignment="Center" Margin="5" FontSize="20"></Label>
                            <Label Content="{Binding totalBasePrice}" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource ForegroundBrush}" Foreground="{DynamicResource ForegroundBrush}" ContentStringFormat="${0:N2}" Grid.Column="1" FontSize="20" VerticalAlignment="Center" Margin="5"></Label>
                            <Label Content="{Binding totalPrice}" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource ForegroundBrush}" Foreground="{DynamicResource ForegroundBrush}" ContentStringFormat="${0:N2}" Grid.Column="2" FontSize="20" VerticalAlignment="Center" Margin="5"></Label>
                            <Button FontSize="20" Content="Edit" Style="{DynamicResource RoundCorner}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}" Click="EditButton_Click" Grid.Column="3" Margin="5"></Button>
                            <Button FontSize="20" Content="X" Style="{DynamicResource RoundCorner}" Background="{DynamicResource BackgroundBrush}" Foreground="Red" Click="DeleteButton_Click" Grid.Column="4" Margin="5"></Button>
                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel>

            <Menu Style="{DynamicResource MenuStyle}">
                <MenuItem Style="{DynamicResource MenuItemStyle}" Header="File" FontSize="20">
                    <MenuItem Name="ClearButton" Header="Clear" Click="ClearButton_Click" Style="{DynamicResource MenuItemStyle}"></MenuItem>
                </MenuItem>

                <MenuItem FontSize="20" Name="SortHeader" Header="Sort" Style="{DynamicResource MenuItemStyle}">
                    <MenuItem 
                            Name="AlphabetAscendingSortButton" 
                            Header="Alphabetical Ascending Order" 
                            Click="AlphabetAscendingSortButton_Click"
                            Style="{DynamicResource MenuItemStyle}"
                            ></MenuItem>
                    <MenuItem 
                            Name="AlphabetDescendingSortButton" 
                            Header="Alphabetical Descending Order" 
                            Click="AlphabetDescendingSortButton_Click"
                            Style="{DynamicResource MenuItemStyle}"
                        ></MenuItem>
                    <MenuItem 
                            Name="AscendingPriceButton" 
                            Header="Ascending Price" 
                            Click="AscendingPriceButton_Click"
                            Style="{DynamicResource MenuItemStyle}"
                        ></MenuItem>
                    <MenuItem 
                            Name="DescendingPriceButton" 
                            Header="Descending Price" 
                            Click="DescendingPriceButton_Click"
                            Style="{DynamicResource MenuItemStyle}"
                        ></MenuItem>
                </MenuItem>
            </Menu>
            

            <Grid Width="auto" Height="auto" Margin="0,5,0,0">
                <Label Style="{DynamicResource LabelStyle}" Content="Tax %" FontSize="30"/>
                <TextBox Style="{DynamicResource RoundTextBox}"
                    FontSize="30"
                    Name="TaxPercentTextBox" 
                    Text="0" 
                    TextChanged="TaxPercentTextBox_TextChanged" 
                   
                    Margin="10,60,10,10"
                    />
            </Grid>

            <Grid Width="auto" Height="120" Margin="0,5,0,0">
                <Label Content="Tip %" FontSize="30" Style="{DynamicResource LabelStyle}"/>
                <TextBox 
                    Style="{DynamicResource RoundTextBox}"
                    FontSize="30" 
                    Name="TipPrecentTextBox" 
                    Text="0" 
                    TextChanged="TipPrecentTextBox_TextChanged" 
                    Margin="10,60,10,10"
                    ></TextBox>
            </Grid>
            <Grid Width="auto" Height="120" Margin="0,5,0,0">
                <Label Content="Service Fee %" FontSize="30" Style="{DynamicResource LabelStyle}"/>
                <TextBox 
                    Style="{DynamicResource RoundTextBox}"
                    FontSize="30"
                    Name="ServiceFeePercentTextBox" 
                    Text="0" 
                    TextChanged="ServiceFeePercentTextBox_TextChanged" 
                    Margin="10,60,10,10"
                    ></TextBox>
            </Grid>

            <Grid Height="60">
                <Button Style="{DynamicResource RoundCorner}" Name="ManageItemsButton" Content="Item Catalog" Background="LightGreen" Click="ManageItemsButton_Click" Margin="10,10,10,10"></Button>
            </Grid>

            <Grid Height="60">
                <Button Style="{DynamicResource RoundCorner}" Content="Add Person" Background="LightGreen" Click="Button_Click" Margin="10"></Button>
            </Grid>

            <Grid Height="60">
                <Button Style="{DynamicResource RoundCorner}" Name="GenerateReportButton" Content="Generate Report" Background="LightGreen" Click="GenerateReportButton_Click" Margin="10"></Button>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
