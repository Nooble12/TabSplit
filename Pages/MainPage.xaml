<Page x:Class="TabSplit.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TabSplit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Gray"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <Menu>
                <MenuItem Header="File">
                    <MenuItem Name="ClearButton" Header="Clear" Click="ClearButton_Click"></MenuItem>
                </MenuItem>
                <MenuItem Name="SortHeader" Header="Sort">
                    <MenuItem Name="AlphabetSortButton" Header="Alphabetical Order" Click="AlphabetSortButton_Click"></MenuItem>
                    <MenuItem Name="DescendingPriceButton" Header="Low to High Price" Click="DescendingPriceButton_Click"></MenuItem>
                    <MenuItem Name="AscendingPriceButton" Header="High to Low Price" Click="AscendingPriceButton_Click"></MenuItem>
                </MenuItem>
            </Menu>
            <TextBox Name="TaxPercentTextBox" Text="Tax Percent" TextChanged="TaxPercentTextBox_TextChanged"></TextBox>
            <TextBox Name="TipPrecentTextBox" Text="Tip Percent" TextChanged="TipPrecentTextBox_TextChanged"></TextBox>
            <TextBox Name="ServiceFeePercentTextBox" Text="Service Fee Percent" TextChanged="ServiceFeePercentTextBox_TextChanged"></TextBox>
            
            <Button Content="Add Person" Background="LightGreen" Click="Button_Click"></Button>

            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Content="Name" Grid.Column="0" Foreground="White"></Label>
                <Label Content="Base Price" Grid.Column="1" Foreground="White"></Label>
                <Label Content="Total Price" Grid.Column="2" Foreground="White"></Label>

            </Grid>

            <ListBox Margin="0, 5, 0, 0" Height="250" Name="ItemListBox" Background="White">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"></EventSetter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="{Binding name}" Foreground="Black" Grid.Column="0" VerticalAlignment="Center" Margin="5"></Label>
                            <Label Content="{Binding totalBasePrice}" ContentStringFormat="${0:N2}" Foreground="Black" Grid.Column="1" VerticalAlignment="Center" Margin="5"></Label>
                            <Label Content="{Binding totalPrice}" ContentStringFormat="${0:N2}" Foreground="Black" Grid.Column="2" VerticalAlignment="Center" Margin="5"></Label>
                            <Button Content="Edit" Foreground="Black" Click="EditButton_Click" Grid.Column="3" Margin="5"></Button>
                            <Button Content="X" Foreground="Red" Click="DeleteButton_Click" Grid.Column="4" Margin="5"></Button>
                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Name="GenerateReportButton" Content="Generate Report" Background="LightGreen" Click="GenerateReportButton_Click"></Button>
        </StackPanel>
    </Grid>
</Page>
